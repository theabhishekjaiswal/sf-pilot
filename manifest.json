{
  "manifest_version": 3,
  "name": "Salesforce Pilot",
  "version": "3.1.0",
  "description": "Supercharge your Salesforce experience! The ultimate navigation toolbar and blazing fast metadata search.",
  "permissions": [
    "scripting",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.lightning.force.com/*",
    "https://*.my.salesforce.com/*",
    "https://*.sandbox.lightning.force.com/*",
    "https://*.sandbox.my.salesforce.com/*",
    "https://*.develop.lightning.force.com/*",
    "https://*.develop.my.salesforce.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.my.salesforce-setup.com/*",
    "https://*.sandbox.my.salesforce-setup.com/*",
    "https://*.develop.my.salesforce-setup.com/*",
    "https://*.siteforce.com/*",
    "https://*.my.site.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.force.com/*",
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.sandbox.lightning.force.com/*",
        "https://*.sandbox.my.salesforce.com/*",
        "https://*.develop.lightning.force.com/*",
        "https://*.develop.my.salesforce.com/*",
        "https://*.salesforce-setup.com/*",
        "https://*.my.salesforce-setup.com/*",
        "https://*.sandbox.my.salesforce-setup.com/*",
        "https://*.develop.my.salesforce-setup.com/*",
        "https://*.siteforce.com/*",
        "https://*.my.site.com/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "css": [
        "src/content/toolbar.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/pages/data/data.html",
        "src/pages/data/data.css",
        "src/pages/data/data.js",
        "assets/icons/logo128.png"
      ],
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.force.com/*",
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.sandbox.lightning.force.com/*",
        "https://*.sandbox.my.salesforce.com/*",
        "https://*.develop.lightning.force.com/*",
        "https://*.develop.my.salesforce.com/*",
        "https://*.salesforce-setup.com/*",
        "https://*.my.salesforce-setup.com/*",
        "https://*.sandbox.my.salesforce-setup.com/*",
        "https://*.develop.my.salesforce-setup.com/*",
        "https://*.siteforce.com/*",
        "https://*.my.site.com/*"
      ]
    }
  ],
  "icons": {
    "16": "assets/icons/logo16.png",
    "32": "assets/icons/logo32.png",
    "48": "assets/icons/logo48.png",
    "128": "assets/icons/logo128.png"
  }
}